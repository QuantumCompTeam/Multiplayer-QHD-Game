\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Star-topology per-player circuit-relative payoff gap (hub player 0 vs.\ each leaf) at $\gamma =\pi /2$, $V{=}4, C{=}3$, noiseless, for $N=2\ldots  6$. The leaves capture the gap at small $N$; the hub captures it at large $N$; the mean (dashed) tracks $3/N$ until $N{=}6$. Data: \texttt  {results/n-scaling-advantage/2026-07-19T0901Z}.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:star}{{4}{4}{Star-topology per-player circuit-relative payoff gap (hub player 0 vs.\ each leaf) at $\gamma =\pi /2$, $V{=}4, C{=}3$, noiseless, for $N=2\ldots 6$. The leaves capture the gap at small $N$; the hub captures it at large $N$; the mean (dashed) tracks $3/N$ until $N{=}6$. Data: \texttt {results/n-scaling-advantage/2026-07-19T0901Z}}{figure.4}{}}
