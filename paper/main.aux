\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Zero-noise circuit-relative payoff gap of the fixed profile $(Q_N,\dots  ,Q_N)$, defined as its mean payoff minus the highest-mean circuit-evaluated restricted $\{D,H\}$ equilibrium payoff, at $\gamma =\pi /2$ and $V{=}4, C{=}3$. The $3/N$ gap (star markers) is attained by GHZ and fully connected at every recorded $N$; the ring has zero gap at $N{=}4$; the star shows a weaker $N{=}6$ value ($0.463$ vs.\ $0.5$); and W tracks below throughout. Filled markers indicate that the profile passes the restricted $\{D,H,Q_N\}$ deviation check, which depends on topology.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:advmap}{{1}{3}{Zero-noise circuit-relative payoff gap of the fixed profile $(Q_N,\dots ,Q_N)$, defined as its mean payoff minus the highest-mean circuit-evaluated restricted $\{D,H\}$ equilibrium payoff, at $\gamma =\pi /2$ and $V{=}4, C{=}3$. The $3/N$ gap (star markers) is attained by GHZ and fully connected at every recorded $N$; the ring has zero gap at $N{=}4$; the star shows a weaker $N{=}6$ value ($0.463$ vs.\ $0.5$); and W tracks below throughout. Filled markers indicate that the profile passes the restricted $\{D,H,Q_N\}$ deviation check, which depends on topology}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Circuit-relative payoff-gap heatmap across the $(N,\text  {topology})$ grid at $V{=}4, C{=}3$ (mean per-player payoff of $(Q_N,\dots  ,Q_N)$ minus the highest-mean circuit-evaluated restricted $\{D,H\}$ equilibrium payoff). GHZ and fully connected hold the $3/N$ gap everywhere; the single dark cell is the ring at $N{=}4$ (gap exactly $0$).}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:heat}{{2}{4}{Circuit-relative payoff-gap heatmap across the $(N,\text {topology})$ grid at $V{=}4, C{=}3$ (mean per-player payoff of $(Q_N,\dots ,Q_N)$ minus the highest-mean circuit-evaluated restricted $\{D,H\}$ equilibrium payoff). GHZ and fully connected hold the $3/N$ gap everywhere; the single dark cell is the ring at $N{=}4$ (gap exactly $0$)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Circuit-relative payoff gap versus entanglement angle $\gamma $ at $N{=}4$ ($V{=}4, C{=}3$, noiseless). GHZ and star hold $0.75$ flat; fully connected dips and recovers; W decays monotonically; and ring falls to zero at $\gamma =\pi /2$. Data: \texttt  {results/gamma-sweep/N4}.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:gamma}{{3}{4}{Circuit-relative payoff gap versus entanglement angle $\gamma $ at $N{=}4$ ($V{=}4, C{=}3$, noiseless). GHZ and star hold $0.75$ flat; fully connected dips and recovers; W decays monotonically; and ring falls to zero at $\gamma =\pi /2$. Data: \texttt {results/gamma-sweep/N4}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Star-topology per-player circuit-relative payoff gap (hub player 0 vs.\ each leaf) at $\gamma =\pi /2$, $V{=}4, C{=}3$, noiseless, for $N=2\ldots  6$. The leaves capture the gap at small $N$; the hub captures it at large $N$; the mean (dashed) tracks $3/N$ until $N{=}6$. Data: \texttt  {results/n-scaling-advantage/2026-07-19T0901Z}.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:star}{{4}{4}{Star-topology per-player circuit-relative payoff gap (hub player 0 vs.\ each leaf) at $\gamma =\pi /2$, $V{=}4, C{=}3$, noiseless, for $N=2\ldots 6$. The leaves capture the gap at small $N$; the hub captures it at large $N$; the mean (dashed) tracks $3/N$ until $N{=}6$. Data: \texttt {results/n-scaling-advantage/2026-07-19T0901Z}}{figure.4}{}}
